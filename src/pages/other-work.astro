---
import Layout from "../layouts/Layout.astro";
import PillNav from "../components/PillNav/PillNav.astro";
import Footer from "../components/Footer/Footer.jsx";

const BASE = '/Kairiin-Koddala';

const items = [
  {
    src: `${BASE}/other-fashion.jpg`,
    type: 'image',
    alt: 'Fashion photography — woman in checkered dress with dramatic shadow lighting',
    labelEn: 'Fashion Photography',
    labelEt: 'Moefotograafia',
    descEn: 'Art direction & styling',
    descEt: 'Kunstiline juhtimine ja stilistika',
    modifier: 'tall',
  },
  {
    src: `${BASE}/other-tartu-poster.jpg`,
    type: 'image',
    alt: 'Tartu Balti Filmipäevad 2024 — event poster design with lime green background and 3D film camera',
    labelEn: 'Tartu Balti Filmipäevad 2024',
    labelEt: 'Tartu Balti Filmipäevad 2024',
    descEn: 'Internship — Eesti Filmi Instituut',
    descEt: 'Praktika — Eesti Filmi Instituut',
    modifier: '',
  },
  {
    src: `${BASE}/other-tartu-billboard.jpg`,
    type: 'image',
    alt: 'Tartu Balti Filmipäevad 2024 poster displayed on a large outdoor billboard in Tartu',
    labelEn: 'Poster in the Wild',
    labelEt: 'Plakat linnas',
    descEn: 'Tartu city billboard',
    descEt: 'Tartu välireklaam',
    modifier: '',
  },
  {
    src: `${BASE}/animation1.gif`,
    type: 'gif',
    alt: 'Hand-drawn animation — a pencil-sketched circle being drawn frame by frame',
    labelEn: 'Hand-drawn Animation',
    labelEt: 'Käsitsi joonistatud animatsioon',
    descEn: 'Frame-by-frame illustration',
    descEt: 'Kaader-kaadri haaval illustratsioon',
    modifier: 'gif',
  },
  {
    src: `${BASE}/animation2.gif`,
    type: 'gif',
    alt: 'Hand-drawn animation — stick figure standing next to a ball',
    labelEn: 'Character Animation',
    labelEt: 'Tegelasanimatsioon',
    descEn: 'Frame-by-frame illustration',
    descEt: 'Kaader-kaadri haaval illustratsioon',
    modifier: 'gif wide',
  },
  {
    src: `${BASE}/animated-interactive-filter.mp4`,
    type: 'video',
    alt: 'KAI Designs — portfolio website built with HTML, CSS and React as part of The Odin Project',
    labelEn: 'KAI Designs — The Odin Project',
    labelEt: 'KAI Designs — The Odin Project',
    descEn: 'HTML · CSS · React',
    descEt: 'HTML · CSS · React',
    modifier: 'wide',
  },
  {
    src: `${BASE}/other-painting.jpg`,
    type: 'image',
    alt: 'Oil painting — blue still life with a tote bag, white pitcher, bowl and spray bottle',
    labelEn: 'Still Life in Blue',
    labelEt: 'Natüürmort sinises',
    descEn: 'Oil on canvas',
    descEt: 'Õlivärv lõuendil',
    modifier: '',
  },
];
---

<Layout title="Other Work — Kairiin Koddala">
  <a href="#main-content" class="skip-to-main">Skip to main content</a>

  <PillNav variant="project" backHref="/Kairiin-Koddala/" />

  <main id="main-content" class="other-work-page">

    <header class="other-work-page__header">
      <div class="section-header" style="border-top: none; padding-top: var(--space-4xl);">
        <h1 class="other-work-page__h1" data-i18n="other_1">Other</h1>
        <h1 class="other-work-page__h1" data-i18n="other_2">Work</h1>
      </div>
      <p class="other-work-page__intro" data-i18n="other_intro">
        Art, graphic experiments, illustrations, animations, and visual explorations — the side of me that exists outside of UX briefs.
      </p>
    </header>

    <div class="other-work-grid">
      {items.map((item) => (
        <div class={`other-work-item${item.modifier ? ' other-work-item--' + item.modifier.split(' ').join(' other-work-item--') : ''}`}>
          <div class="other-work-media">
            {item.type === 'video' ? (
              <video
                src={item.src}
                autoplay
                loop
                muted
                playsinline
                aria-label={item.alt}
              />
            ) : (
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
              />
            )}
          </div>
          <div class="other-work-caption">
            <span class="other-work-label" data-label-en={item.labelEn} data-label-et={item.labelEt}>{item.labelEn}</span>
            <span class="other-work-desc" data-desc-en={item.descEn} data-desc-et={item.descEt}>{item.descEn}</span>
          </div>
        </div>
      ))}
    </div>

  </main>

  <Footer client:load />
</Layout>

<script>
  // ── i18n for Other Work page ──────────────────────────────────────────────
  const translations: Record<string, Record<string, string>> = {
    en: {
      nav_back: '← Home',
      other_1: 'Other', other_2: 'Work',
      other_intro: 'Art, graphic experiments, illustrations, animations, and visual explorations — the side of me that exists outside of UX briefs.',
    },
    et: {
      nav_back: '← Avaleht',
      other_1: 'Muud', other_2: 'Tööd',
      other_intro: 'Kunst, graafilised eksperimendid, illustratsioonid, animatsioonid ja visuaalsed uurimused — see pool minust, mis eksisteerib väljaspool UX-ülesandeid.',
    },
  };

  (function () {
    let lang = localStorage.getItem('lang') || 'en';
    const toggle = document.getElementById('lang-toggle');
    const langLabel = document.getElementById('lang-label');

    function applyLang(l: string) {
      const t = translations[l];
      if (!t) return;
      document.documentElement.lang = l;

      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = (el as HTMLElement).getAttribute('data-i18n')!;
        if (t[key] !== undefined) el.textContent = t[key];
      });

      // Update item labels and descs
      document.querySelectorAll('.other-work-label').forEach((el) => {
        const htmlEl = el as HTMLElement;
        const val = l === 'et' ? htmlEl.dataset.labelEt : htmlEl.dataset.labelEn;
        if (val) el.textContent = val;
      });
      document.querySelectorAll('.other-work-desc').forEach((el) => {
        const htmlEl = el as HTMLElement;
        const val = l === 'et' ? htmlEl.dataset.descEt : htmlEl.dataset.descEn;
        if (val) el.textContent = val;
      });

      if (langLabel) langLabel.textContent = l === 'en' ? 'ET' : 'EN';
      localStorage.setItem('lang', l);
      lang = l;
    }

    applyLang(lang);

    if (toggle) {
      toggle.addEventListener('click', () => {
        applyLang(lang === 'en' ? 'et' : 'en');
      });
    }
  })();
</script>

<style>
  .other-work-page {
    min-height: 100vh;
  }

  .other-work-page__h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 5rem);
    font-style: italic;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .other-work-page__intro {
    padding: 0 var(--container-padding) var(--space-2xl);
    max-width: 600px;
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.7;
  }
</style>
