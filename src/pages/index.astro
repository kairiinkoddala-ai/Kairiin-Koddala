---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import FlowingMenu from "../components/FlowingMenu/FlowingMenu.jsx";

const aboutEntries = await getCollection("about");
const about = aboutEntries[0];
const { Content: AboutContent } = await render(about);

const projects = await getCollection("projects");
const sortedProjects = projects.sort(
  (a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99)
);

const menuItems = sortedProjects.map((project) => ({
  link: `/projects/${project.id}`,
  text: project.data.title,
  image: project.data.coverImage.src,
}));
---

<Layout title={`${about.data.name} — ${about.data.title}`}>
  <!-- Skip to main content -->
  <a href="#main-content" class="skip-to-main">Skip to main content</a>

  <!-- Top Bar -->
  <header class="top-bar">
    <div class="top-bar-left">
      <a href="mailto:{about.data.contact.email}" class="availability-badge">
        Available for Work
      </a>
    </div>
    <div class="top-bar-right">
      {about.data.socials.map((social) => (
        <a href={social.url} target="_blank" rel="noopener noreferrer">
          {social.platform.substring(0, 2).toUpperCase()}
        </a>
      ))}
    </div>
  </header>

  <main id="main-content">
    <!-- Hero Section -->
    <section class="hero">
      <h1>
        <span class="hero-line">{about.data.title}</span>
        <span class="hero-line">from Tallinn</span>
        <span class="hero-line">working globally.</span>
      </h1>
      <p class="hero-subtitle">{about.data.name}</p>
    </section>

    <!-- Selected Work -->
    <section class="projects-section">
      <div class="section-header">
        <h2>Selected</h2>
        <h2>Work</h2>
      </div>

      <div class="flowing-menu-wrap">
        <FlowingMenu
          client:load
          items={menuItems}
          speed={18}
          bgColor="#E8E4D4"
          textColor="#1A1A1A"
          marqueeBgColor="#E8402A"
          marqueeTextColor="#E8E4D4"
          borderColor="#c8c2ae"
        />
      </div>
    </section>

    <!-- About Section -->
    <section class="about-section">
      <div class="section-header" style="padding-left: 0; padding-right: 0;">
        <h2>About</h2>
        <h2>{about.data.name.split(' ')[0]}</h2>
      </div>

      <div class="about-content">
        <AboutContent />
      </div>

      <div style="margin-top: var(--space-xl);">
        <h3 style="font-size: 11px; letter-spacing: 0.15em; color: var(--color-text-dim); margin-bottom: var(--space-lg);">Skills</h3>
        <p style="color: var(--color-text-muted); letter-spacing: 0.05em;">
          {about.data.skills.join(' · ')}
        </p>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="contact-section">
      <h2 class="contact-title">Get in Touch</h2>

      <div class="contact-grid">
        {about.data.contact.phone && (
          <a href={`tel:${about.data.contact.phone}`} class="contact-item">
            <span class="contact-item-value">
              {about.data.contact.phone.split('').join(' ')}
            </span>
            <span class="contact-item-label">Call</span>
          </a>
        )}

        <a href={`mailto:${about.data.contact.email}`} class="contact-item">
          <span class="contact-item-value">
            {about.data.contact.email.split('').join(' ')}
          </span>
          <span class="contact-item-label">Mail</span>
        </a>

        {about.data.socials.map((social) => (
          <a href={social.url} target="_blank" rel="noopener noreferrer" class="contact-item">
            <span class="contact-item-value">
              {social.platform.toUpperCase().split('').join(' ')}
            </span>
            <span class="contact-item-label">Follow</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-socials">
        {about.data.socials.map((social) => (
          <a href={social.url} target="_blank" rel="noopener noreferrer">
            {social.platform.substring(0, 2).toUpperCase()}
          </a>
        ))}
      </div>
      <span class="footer-credit">
        © {new Date().getFullYear()} {about.data.name}
      </span>
    </footer>
  </main>
</Layout>
