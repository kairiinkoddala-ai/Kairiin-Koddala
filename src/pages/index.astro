---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import FlowingMenu from "../components/FlowingMenu/FlowingMenu.jsx";
import HeroMetaballs from "../components/HeroMetaballs/HeroMetaballs.jsx";

const aboutEntries = await getCollection("about");
const about = aboutEntries[0];
const { Content: AboutContent } = await render(about);

const projects = await getCollection("projects");
const sortedProjects = projects.sort(
  (a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99)
);

const menuItems = sortedProjects.map((project) => ({
  link: `/Kairiin-Koddala/projects/${project.id}`,
  text: project.data.title,
  image: project.data.coverImage.src,
}));
---

<Layout title={`${about.data.name} — ${about.data.title}`}>
  <!-- Skip to main content -->
  <a href="#main-content" class="skip-to-main">Skip to main content</a>

  <!-- Floating Pill Nav -->
  <nav class="pill-nav" aria-label="Page sections">
    <a href="#section-hey" class="pill-nav-item" data-section="section-hey">
      <span class="pill-nav-num">01/</span><span class="pill-nav-label" data-i18n="nav_hey">HEY</span>
    </a>
    <a href="#section-about" class="pill-nav-item" data-section="section-about">
      <span class="pill-nav-num">02/</span><span class="pill-nav-label" data-i18n="nav_about">ABOUT</span>
    </a>
    <a href="#section-work" class="pill-nav-item" data-section="section-work">
      <span class="pill-nav-num">03/</span><span class="pill-nav-label" data-i18n="nav_work">WORK</span>
    </a>
    <a href="#section-contact" class="pill-nav-item" data-section="section-contact">
      <span class="pill-nav-num">04/</span><span class="pill-nav-label" data-i18n="nav_contact">CONTACT</span>
    </a>
    <!-- Language toggle -->
    <button class="pill-nav-lang" id="lang-toggle" aria-label="Switch language">
      <span id="lang-label">ET</span>
    </button>
  </nav>

  <main id="main-content">
    <!-- Hero Section — Metaballs scratch-card reveal over video -->
    <HeroMetaballs
      client:load
      videoSrc="https://videos.pexels.com/video-files/3571264/3571264-uhd_2560_1440_30fps.mp4"
      overlayColor="#2E2D1E"
      color="#ffffff"
      cursorBallColor="#ffffff"
      cursorBallSize={2}
      ballCount={15}
      animationSize={30}
      enableMouseInteraction={true}
      enableTransparency={true}
      hoverSmoothness={0.15}
      clumpFactor={1}
      speed={0.3}
    >
      <h1>
        <span class="hero-line" data-i18n="hero_line1">Digital Product</span>
        <span class="hero-line" data-i18n="hero_line2">Designer</span>
        <span class="hero-line" data-i18n="hero_line3">from Tallinn.</span>
      </h1>
      <p class="hero-subtitle">{about.data.name}</p>
    </HeroMetaballs>

    <!-- Selected Work -->
    <section class="projects-section" id="section-work">
      <div class="section-header">
        <h2 data-i18n="selected_1">Selected</h2>
        <h2 data-i18n="selected_2">Work</h2>
      </div>

      <div class="flowing-menu-wrap">
        <FlowingMenu
          client:load
          items={menuItems}
          speed={18}
          bgColor="#F2EDE6"
          textColor="#1e1c14"
          marqueeBgColor="#C97FA8"
          marqueeTextColor="#F2EDE6"
          borderColor="#d6cfc4"
        />
      </div>
    </section>

    <!-- About Section -->
    <section class="about-section" id="section-about">
      <div class="section-header" style="padding-left: 0; padding-right: 0;">
        <h2 data-i18n="about_1">About</h2>
        <h2>{about.data.name.split(' ')[0]}</h2>
      </div>

      <div class="about-content">
        <p data-i18n-bio class="about-bio-text"></p>
      </div>

      <div style="margin-top: var(--space-xl);">
        <h3 style="font-size: 11px; letter-spacing: 0.15em; color: var(--color-text-dim); margin-bottom: var(--space-lg);" data-i18n="skills_label">Skills</h3>
        <p style="color: var(--color-text-muted); letter-spacing: 0.05em;">
          {about.data.skills.join(' · ')}
        </p>
      </div>
    </section>

    <!-- CV Section -->
    <section class="cv-section">
      <div class="section-header">
        <h2 data-i18n="cv_1">Curriculum</h2>
        <h2 data-i18n="cv_2">Vitae</h2>
      </div>

      <div class="cv-grid">
        <div class="cv-column">
          <h3 class="cv-column-label" data-i18n="cv_exp">Experience</h3>
          {about.data.experience?.map((entry) => (
            <div class="cv-entry">
              <div class="cv-entry-main">
                <span class="cv-entry-role">{entry.role}</span>
                <span class="cv-entry-company">{entry.company}</span>
              </div>
              <span class="cv-entry-years">
                {entry.startYear}–{entry.endYear ? entry.endYear : <span data-i18n="cv_present">Present</span>}
              </span>
            </div>
          ))}
        </div>

        <div class="cv-column">
          <h3 class="cv-column-label" data-i18n="cv_edu">Education</h3>
          {about.data.education.map((entry) => (
            <div class="cv-entry">
              <div class="cv-entry-main">
                <span class="cv-entry-role">{entry.degree}</span>
                <span class="cv-entry-company">{entry.institution}</span>
              </div>
              <span class="cv-entry-years">
                {entry.startYear}–{entry.endYear ? entry.endYear : <span data-i18n="cv_present">Present</span>}
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="contact-section" id="section-contact" style="background: var(--color-bg-secondary); border-top: none;">
      <h2 class="contact-title" style="color: #F2EDE6;" data-i18n="contact_title">Get in Touch</h2>

      <div class="contact-grid">
        <a href={`mailto:${about.data.contact.email}`} class="contact-item" style="border-top-color: rgba(242,237,230,0.15);">
          <span class="contact-item-value" style="color: #F2EDE6;">
            {about.data.contact.email.split('').join(' ')}
          </span>
          <span class="contact-item-label" style="color: rgba(242,237,230,0.5);" data-i18n="contact_mail_lbl">Mail</span>
        </a>

        {about.data.socials.map((social) => (
          <a href={social.url} target="_blank" rel="noopener noreferrer" class="contact-item" style="border-top-color: rgba(242,237,230,0.15);">
            <span class="contact-item-value" style="color: #F2EDE6;">
              {social.platform.toUpperCase().split('').join(' ')}
            </span>
            <span class="contact-item-label" style="color: rgba(242,237,230,0.5);" data-i18n="contact_follow">Follow</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer" style="background: var(--color-bg-secondary); border-top-color: rgba(242,237,230,0.15);">
      <div class="footer-socials">
        {about.data.socials.map((social) => (
          <a href={social.url} target="_blank" rel="noopener noreferrer" style="color: rgba(242,237,230,0.5);">
            {social.platform.substring(0, 2).toUpperCase()}
          </a>
        ))}
      </div>
      <span class="footer-credit" style="color: rgba(242,237,230,0.4);">
        © {new Date().getFullYear()} {about.data.name}
      </span>
    </footer>
  </main>
</Layout>

<script>
  // ── i18n translations (inline — no import needed in Astro client script) ──
  const translations = {
    en: {
      nav_hey: 'HEY', nav_about: 'ABOUT', nav_work: 'WORK', nav_contact: 'CONTACT',
      hero_line1: 'Digital Product', hero_line2: 'Designer', hero_line3: 'from Tallinn.',
      selected_1: 'Selected', selected_2: 'Work',
      about_1: 'About', cv_1: 'Curriculum', cv_2: 'Vitae',
      skills_label: 'Skills', cv_exp: 'Experience', cv_edu: 'Education', cv_present: 'Present',
      contact_title: 'Get in Touch', contact_mail_lbl: 'Mail', contact_follow: 'Follow',
      bio: `I design experiences for people — and I believe the best way to do that is to first understand them from the front line.\n\nOver the past 10 years I've worked directly with customers in high-pressure, high-volume environments: managing 20 tables solo on a surprise rush day, de-escalating difficult situations in real time, and learning that most service failures aren't people problems — they're system problems. That lens has made me a sharper designer.\n\nAt the Estonian Tax and Customs Board, I redesigned the internal Confluence environment used across all digital product teams, and prototyped the Customs Duty Calculator mobile view — which shipped to production. I cut redundant development work by introducing component-level animations and interactive states directly in Figma, eliminating the outdated practice of building new frames for every micro-interaction.\n\nOn the Ole Valmis crisis preparedness app, a user during testing told me: "Why do I need a trash bag? I'm not sorting trash if there's a war." That moment rewired the entire product direction. The list wasn't the problem — the missing context was. I redesigned the feature to educate users on dual-use logic (a trash bag doubles as an emergency raincoat or sleeping bag barrier), and the client's development specialist reached out directly for continued collaboration.\n\nAt Botik, I own the full content strategy: I designed and execute a data-driven social media system that grew inquiry volume 27.3%, retained +98.7% of incoming traffic, and moved our Google position from 9.5 to 6.2 — a 29.8% organic traffic increase. I initiated quarterly statistical overviews for ownership, built an inventory feedback loop with the bar team, and redesigned front-of-house workflow before peak season.\n\nI'm now targeting Customer Support and Customer Success roles at product companies — deliberately. The fastest way to become a highly effective in-house UX or Service Designer is to spend time where unfiltered user pain hits first. I'm not waiting for a junior design title. I'm going to earn product intuition from the inside.\n\nIf you're building a product team that values designers who have actually talked to users for a decade — let's connect.`,
    },
    et: {
      nav_hey: 'HEI', nav_about: 'MINUST', nav_work: 'TÖÖD', nav_contact: 'KONTAKT',
      hero_line1: 'Digitaalne toote-', hero_line2: 'disainer', hero_line3: 'Tallinnast.',
      selected_1: 'Valitud', selected_2: 'Tööd',
      about_1: 'Minust', cv_1: 'Curriculum', cv_2: 'Vitae',
      skills_label: 'Oskused', cv_exp: 'Töökogemus', cv_edu: 'Haridus', cv_present: 'Praeguseni',
      contact_title: 'Võta Ühendust', contact_mail_lbl: 'Kiri', contact_follow: 'Jälgi',
      bio: `Ma disainin inimestele kogemusi — ja usun, et parim viis selleks on neid kõigepealt eesliinil mõista.\n\nViimase 10 aasta jooksul olen töötanud otse klientidega kõrge surve ja suure mahuga keskkondades: haldanud üksinda 20-laualise terrasse üllatuslikult kiire päeva ajal, lahendanud konflikte reaalajas ja õppinud, et enamik teenindusprobleeme pole inimeste, vaid süsteemide viga. See vaatenurk on teinud minust teravama disaineri.\n\nMaksu- ja Tolliametis kujundasin ümber kõigi digitaalsete tootemeeskondade sisemise Confluence'i keskkonna ning prototüüpisin tollimaksukalkulaatori mobiilivaate — mis jõudis tootmisse. Vähendasin arenduskoormust, lisades Figmas komponentide tasandi animatsioonid ja interaktiivsed olekud, mis asendas vananenud tava luua iga mikrointeraktsiooni jaoks uus kaader.\n\nOle Valmis kriisirakenduse puhul ütles kasutaja testimisel: „Miks mul on prügikott vaja? Ma ei sorteeri prügi, kui sõda on." See hetk muutis kogu toote suuna. Probleem polnud nimekirjas — puudus kontekst. Kujundasin funktsiooni ümber nii, et see selgitab iga eseme kahekordset kasutust (prügikott toimib hädaolukorras vihmamantli või magamiskoti barjäärina), ning kliendi arendusspetsialist võttis ühendust edasise koostöö arutamiseks.\n\nBotikus juhin kogu sisustrateegiat: lõin andmepõhise sotsiaalmeedia süsteemi, mis kasvas päringute mahtu 27,3%, hoidis +98,7% sissetulevat liiklust ning parandas meie Google'i keskmist positsiooni 9,5-lt 6,2-le — 29,8% orgaanilise liikluse kasv. Käivitasin kvartaliaruanded omanikule, lõin inventuuri tagasiside ahela baariga ning kujundasin enne hooaega ümber teeninduse töövoo.\n\nOtsin praegu teadlikult klienditugi- ja kliendiedukuse rolle tootepõhistes ettevõtetes. Kiireim viis saada tõhusaks sise-UX- või teenusedisaineriks on veeta aega seal, kus kasutajate valu kõige vahetumalt ilmneb. Ma ei oota juunior-disaineri ametinimetust — tahan toote intuitsiooni seestpoolt välja teenida.\n\nKui ehitad tootemeeskonda, mis väärtustab disainereid, kes on kasutajatega kümme aastat otse suhelnud — võtame ühendust.`,
    },
  };

  // ── Language toggle logic ──────────────────────────────────────────────────
  (function () {
    // Read saved preference or default to English
    let lang = localStorage.getItem('lang') || 'en';
    const toggle = document.getElementById('lang-toggle');
    const langLabel = document.getElementById('lang-label');

    function applyLang(l) {
      const t = translations[l];
      if (!t) return;

      // Update html lang attribute
      document.documentElement.lang = l;

      // Update all [data-i18n] elements
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (t[key] !== undefined) el.textContent = t[key];
      });

      // Update bio (multi-paragraph, rendered as separate <p> tags)
      const bioEl = document.querySelector('[data-i18n-bio]');
      if (bioEl && t.bio) {
        bioEl.innerHTML = t.bio
          .split('\n\n')
          .map((p) => `<p>${p.replace(/\n/g, '<br>')}</p>`)
          .join('');
      }

      // Update toggle button label (shows the OTHER language you can switch to)
      if (langLabel) langLabel.textContent = l === 'en' ? 'ET' : 'EN';

      localStorage.setItem('lang', l);
      lang = l;
    }

    // Apply on load
    applyLang(lang);

    // Toggle on click
    if (toggle) {
      toggle.addEventListener('click', () => {
        applyLang(lang === 'en' ? 'et' : 'en');
      });
    }
  })();

  // ── Pill nav: smooth scroll + active state ──────────────────────────────────
  (function () {
    const navItems = document.querySelectorAll('.pill-nav-item');

    navItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = item.getAttribute('href')?.slice(1);
        if (!targetId) return;
        const target =
          document.getElementById(targetId) ||
          document.querySelector(`[data-nav-id="${targetId}"]`);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    const sections = [
      { id: 'hero-section',    navId: 'section-hey' },
      { id: 'section-about',   navId: 'section-about' },
      { id: 'section-work',    navId: 'section-work' },
      { id: 'section-contact', navId: 'section-contact' },
    ];

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const match = sections.find((s) => s.id === entry.target.id);
          if (!match) return;
          navItems.forEach((item) => {
            item.classList.toggle(
              'is-active',
              item.getAttribute('data-section') === match.navId
            );
          });
        });
      },
      { threshold: 0.35 }
    );

    sections.forEach(({ id }) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  })();
</script>
