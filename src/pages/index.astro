---
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import HeroMetaballs from "../components/HeroMetaballs/HeroMetaballs.jsx";
import Footer from "../components/Footer/Footer.jsx";
import PillNav from "../components/PillNav/PillNav.astro";

const aboutEntries = await getCollection("about");
const about = aboutEntries[0];
const { Content: AboutContent } = await render(about);

const projects = await getCollection("projects");
const sortedProjects = projects.sort(
  (a, b) => (a.data.sortOrder ?? Infinity) - (b.data.sortOrder ?? Infinity)
);

// Pre-optimise cover images for all projects in the work index
const projectImages = await Promise.all(
  sortedProjects.map((p) =>
    getImage({ src: p.data.coverImage, width: 600, format: "webp" })
  )
);
---

<Layout title={`${about.data.name} — ${about.data.title}`}>
  <!-- Skip to main content -->
  <a href="#main-content" class="skip-to-main">Skip to main content</a>

  <!-- Floating Pill Nav -->
  <PillNav variant="home" />

  <main id="main-content">
    <!-- Hero Section — Metaballs scratch-card reveal over video -->
    <HeroMetaballs
      client:load
      videoSrc="https://videos.pexels.com/video-files/3571264/3571264-uhd_2560_1440_30fps.mp4"
      overlayColor="#2E2D1E"
      color="#ffffff"
      cursorBallColor="#ffffff"
      cursorBallSize={2}
      ballCount={15}
      animationSize={30}
      enableMouseInteraction={true}
      enableTransparency={true}
      hoverSmoothness={0.15}
      clumpFactor={1}
      speed={0.3}
    >
      <h1>
        <span class="hero-line" data-i18n="hero_line1">Digital Product</span>
        <span class="hero-line" data-i18n="hero_line2">Designer</span>
        <span class="hero-line" data-i18n="hero_line3">from Tallinn.</span>
      </h1>
      <p class="hero-subtitle">{about.data.name}</p>
    </HeroMetaballs>

    <!-- Selected Work — Visual Project Showcase Grid -->
    <section class="projects-section" id="section-work">
      <div class="section-header">
        <h2 data-i18n="selected_1">Selected</h2>
        <h2 data-i18n="selected_2">Work</h2>
      </div>

      <!-- ── Filter Bar ── -->
      <div class="filter-bar" role="group" aria-label="Filter projects by discipline">
        {[
          { key: 'all',                  label: 'All' },
          { key: 'UX/UI',                label: 'UX/UI' },
          { key: 'Business Strategy',    label: 'Business Strategy' },
          { key: 'Interaction Design',   label: 'Interaction Design' },
          { key: 'Creative Technology',  label: 'Creative Technology' },
        ].map(({ key, label }) => (
          <button
            class={`filter-pill${key === 'all' ? ' filter-pill--active' : ''}`}
            data-filter={key}
            aria-pressed={key === 'all' ? 'true' : 'false'}
            type="button"
          >
            {label}
          </button>
        ))}
      </div>

      <!-- Work Index — three-track project rows -->
      <div class="work-index" id="work-index">
        {sortedProjects.map((project, i) => (
          <div
            class="project-index-row"
            data-filter-tags={(project.data.filterTags ?? project.data.tags).join(',')}
            data-index={i}
            aria-hidden={i >= 3 ? 'true' : 'false'}
            style={i >= 3 ? 'display:none' : ''}
          >
            <!-- Left Track: small muted category label -->
            <div class="project-index-row__left">
              <span class="project-index-row__meta">
                {(project.data.tags ?? []).join(' · ')}
              </span>
            </div>

            <!-- Middle Track: title + description + learn more link -->
            <div class="project-index-row__middle">
              <a
                href={`/Kairiin-Koddala/projects/${project.id}`}
                aria-label={`View case study: ${project.data.title}`}
                class="project-index-row__title-link"
              >
                <h3
                  class="project-index-row__title"
                  data-project-title-en={project.data.title}
                  data-project-title-et={project.data.titleEt ?? project.data.title}
                >
                  {project.data.title}
                </h3>
              </a>
              <p class="project-index-row__desc">{project.data.description}</p>
              <a
                href={`/Kairiin-Koddala/projects/${project.id}`}
                class="project-index-row__learn-more"
                tabindex="-1"
                aria-hidden="true"
              >
                Learn More
              </a>
            </div>

            <!-- Right Track: clean landscape thumbnail -->
            <div class="project-index-row__right">
              <img
                src={projectImages[i].src}
                alt={`${project.data.title} project cover`}
                class="project-index-row__image"
                loading={i === 0 ? 'eager' : 'lazy'}
                width="600"
                height="400"
              />
            </div>
          </div>
        ))}
      </div>

      <!-- Load More / Show Less toggle -->
      <div class="work-index-toggle" id="work-index-toggle">
        <button
          class="work-index-toggle__btn"
          id="work-toggle-btn"
          type="button"
          aria-expanded="false"
          aria-controls="work-index"
        >
          <span class="work-index-toggle__label" id="work-toggle-label">Load More</span>
          <span class="work-index-toggle__icon" id="work-toggle-icon" aria-hidden="true">↓</span>
        </button>
      </div>
    </section>

    <!-- About Section -->
    <section class="about-section" id="section-about">
      <div class="section-header" style="padding-left: 0; padding-right: 0;">
        <h2 data-i18n="about_1">About</h2>
        <h2>{about.data.name.split(' ')[0]}</h2>
      </div>

      <div class="about-content">
        <p data-i18n-bio class="about-bio-text"></p>
      </div>

      <!-- Skills as interactive pill tags -->
      <div class="skills-block" style="margin-top: var(--space-xl);">
        <h3 class="skills-block__label" data-i18n="skills_label">Skills</h3>
        <div class="skills-pills" role="list" aria-label="Skills">
          {about.data.skills.map((skill: string) => (
            <span class="skill-pill" role="listitem">{skill}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- CV Section -->
    <section class="cv-section" id="section-cv" aria-label="Curriculum Vitae">
      <div class="section-header">
        <h2 data-i18n="cv_1">Curriculum</h2>
        <h2 data-i18n="cv_2">Vitae</h2>
      </div>

      <div class="cv-editorial">
        <!-- Left column: section label -->
        <div class="cv-editorial__header">
          <span class="cv-col__label" data-i18n="cv_edu">Education</span>
        </div>

        <!-- Right column: all entries stacked vertically -->
        <div class="cv-editorial__entries">
          <!-- Education entries -->
          <div class="cv-entry">
            <div class="cv-entry-main">
              <span class="cv-entry-role">BA Digital Product Design</span>
              <span class="cv-entry-company">Estonian Academy of Arts (EKA)</span>
            </div>
            <span class="cv-entry-years">2023–<span data-i18n="cv_present">Present</span></span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-main">
              <span class="cv-entry-role">Erasmus+ Exchange Programme</span>
              <span class="cv-entry-company">Faculty of Fine Arts, University of Porto (FBAUP)</span>
            </div>
            <span class="cv-entry-years">Exchange</span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-main">
              <span class="cv-entry-role">Advanced Interaction & Prototyping Workshop</span>
              <span class="cv-entry-company">Tokyo University of the Arts Design Lab</span>
            </div>
            <span class="cv-entry-years">Workshop</span>
          </div>

          <!-- Milestone divider between Education and Experience -->
          <hr class="milestone-divider" aria-hidden="true" />

          <span class="cv-col__label" data-i18n="cv_exp">Experience</span>

          <!-- Experience entries -->
          <div class="cv-entry">
            <div class="cv-entry-main">
              <span class="cv-entry-role">Service Design Intern</span>
              <span class="cv-entry-company">Estonian Tax and Customs Board (MTA)</span>
            </div>
            <span class="cv-entry-years">2024–2024</span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-main">
              <span class="cv-entry-role">Social Media Manager & Operations Strategist</span>
              <span class="cv-entry-company">Botik Garden Bar</span>
            </div>
            <span class="cv-entry-years">2025–<span data-i18n="cv_present">Present</span></span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-main">
              <span class="cv-entry-role">Freelance Designer</span>
              <span class="cv-entry-company">Service & Graphic Design</span>
            </div>
            <span class="cv-entry-years">Ongoing</span>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-main">
              <span class="cv-entry-role">Senior Customer Experience Specialist</span>
              <span class="cv-entry-company">Hospitality Sector</span>
            </div>
            <span class="cv-entry-years">2015–<span data-i18n="cv_present">Present</span></span>
          </div>

          <!-- Milestone divider between Experience and Honors -->
          <hr class="milestone-divider" aria-hidden="true" />

          <span class="cv-col__label" data-i18n="cv_honors">Honors</span>

          <!-- Honors entries -->
          <div class="cv-entry">
            <div class="cv-entry-main">
              <span class="cv-entry-role">2025 Student Service Design Challenge</span>
              <span class="cv-entry-company" data-i18n="cv_honor_finalist">Global Finalist — June 2025</span>
            </div>
          </div>
          <div class="cv-entry">
            <div class="cv-entry-main">
              <span class="cv-entry-role">Student Business & Entrepreneurship Competition</span>
              <span class="cv-entry-company" data-i18n="cv_honor_jury">Volunteer Jury Member — Product Design Representative</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer — Pre-footer CTA + Main footer with Spotify, project card, and contact -->
    <Footer client:load />
  </main>
</Layout>

<script>
  // ── i18n translations (inline — no import needed in Astro client script) ──
  const translations = {
    en: {
      nav_hey: 'HEY', nav_about: 'ABOUT', nav_work: 'WORK', nav_contact: 'CONTACT',
      nav_back: '← Home',
      hero_line1: 'Digital Product', hero_line2: 'Designer', hero_line3: 'from Tallinn.',
      selected_1: 'Selected', selected_2: 'Work',
      archive_label: 'Other Explorations',
      about_1: 'About', cv_1: 'Curriculum', cv_2: 'Vitae',
      skills_label: 'Skills', cv_exp: 'Experience', cv_edu: 'Education', cv_present: 'Present', cv_view_full: 'View full CV',
      cv_responsibilities: 'Responsibilities', cv_focus: 'Focus Areas', cv_honors: 'Honors & Volunteering',
      cv_badge_award: 'Award', cv_badge_volunteer: 'Volunteer',
      cv_honor_finalist: 'Global Finalist — Issued June 2025',
      cv_honor_jury: 'Volunteer Jury Member — Product Design Representative evaluating student startup pitches and prototypes',
      cv_design_skills: 'Design & Strategy', cv_languages: 'Languages', cv_native: 'Native',
      contact_title: 'Get in Touch', contact_mail_lbl: 'Mail', contact_follow: 'Follow',
      other_1: 'Other', other_2: 'Work',
      other_label_fashion: 'Fashion Photography', other_desc_fashion: 'Art direction & styling',
      other_label_poster: 'Tartu Balti Filmipäevad 2024', other_desc_poster: 'Internship — Eesti Filmi Instituut',
      other_label_billboard: 'Poster in the Wild', other_desc_billboard: 'Tartu city billboard',
      other_label_anim1: 'Hand-drawn Animation', other_desc_anim1: 'Frame-by-frame illustration',
      other_label_anim2: 'Character Animation', other_desc_anim2: 'Frame-by-frame illustration',
      other_label_odin: 'KAI Designs — The Odin Project', other_desc_odin: 'HTML · CSS · React',
      other_label_painting: 'Still Life in Blue', other_desc_painting: 'Oil on canvas',
      bio: `I grew up in the countryside, where life naturally revolves around small-knit communities, shared rituals, and looking out for one another. That upbringing completely shapes how I approach design. To me, systems aren't just blocks of logic — they are digital neighborhoods where people should feel seen, supported, and safe, especially when things get overwhelming.\n\nDesign-wise, I am deeply curious. I don't like staying on the surface; I want to sink my teeth into a topic, sit with the data, and truly understand the analytical why behind human behavior. But I also believe you can't design a meaningful system from a distance.\n\nFor the past decade, I've spent my time on the front lines of customer service — handling high-pressure rushes solo, de-escalating stressful moments in real time, and learning that when a system fails, it's rarely a people problem; it's an empathy problem. Whether I'm mapping out dual-use crisis logic for national emergency apps, restructuring workflows for a beloved local garden bar like Botik, or smoothing out internal data systems, my goal is always to design with clarity and care.\n\nI don't just want to build efficient products; I want to build thoughtful experiences that honor the people using them. If you value a deeply analytical, endlessly curious designer who brings a decade of unfiltered human insight to the table — let's create something meaningful together.`,
    },
    et: {
      nav_hey: 'HEI', nav_about: 'MINUST', nav_work: 'TÖÖD', nav_contact: 'KONTAKT',
      nav_back: '← Avaleht',
      hero_line1: 'Digitaalne toote-', hero_line2: 'disainer', hero_line3: 'Tallinnast.',
      selected_1: 'Valitud', selected_2: 'Tööd',
      archive_label: 'Muud Projektid',
      about_1: 'Minust', cv_1: 'Curriculum', cv_2: 'Vitae',
      skills_label: 'Oskused', cv_exp: 'Töökogemus', cv_edu: 'Haridus', cv_present: 'Praeguseni', cv_view_full: 'Vaata täielikku CV-d',
      cv_responsibilities: 'Ülesanded', cv_focus: 'Fookusalad', cv_honors: 'Tunnustused & Vabatahtlik töö',
      cv_badge_award: 'Auhind', cv_badge_volunteer: 'Vabatahtlik',
      cv_honor_finalist: 'Globaalne finalist — Väljastatud juuni 2025',
      cv_honor_jury: 'Vabatahtlik žüriiliige — Tootedisaini esindaja, hindamas üliõpilaste idufirmade esitlusi ja prototüüpe',
      cv_design_skills: 'Disain & Strateegia', cv_languages: 'Keeled', cv_native: 'Emakeel',
      contact_title: 'Võta Ühendust', contact_mail_lbl: 'Kiri', contact_follow: 'Jälgi',
      other_1: 'Muud', other_2: 'Tööd',
      other_label_fashion: 'Moefotograafia', other_desc_fashion: 'Kunstiline juhtimine ja stilistika',
      other_label_poster: 'Tartu Balti Filmipäevad 2024', other_desc_poster: 'Praktika — Eesti Filmi Instituut',
      other_label_billboard: 'Plakat linnas', other_desc_billboard: 'Tartu välireklaam',
      other_label_anim1: 'Käsitsi joonistatud animatsioon', other_desc_anim1: 'Kaader-kaadri haaval illustratsioon',
      other_label_anim2: 'Tegelasanimatsioon', other_desc_anim2: 'Kaader-kaadri haaval illustratsioon',
      other_label_odin: 'KAI Designs — The Odin Project', other_desc_odin: 'HTML · CSS · React',
      other_label_painting: 'Natüürmort sinises', other_desc_painting: 'Õlivärv lõuendil',
      bio: `Ma disainin inimestele kogemusi — ja usun, et parim viis selleks on neid kõigepealt eesliinil mõista.\n\nViimase 10 aasta jooksul olen töötanud otse klientidega kõrge surve ja suure mahuga keskkondades: haldanud üksinda 20-laualise terrasse üllatuslikult kiire päeva ajal, lahendanud konflikte reaalajas ja õppinud, et enamik teenindusprobleeme pole inimeste, vaid süsteemide viga. See vaatenurk on teinud minust teravama disaineri.\n\nMaksu- ja Tolliametis kujundasin ümber kõigi digitaalsete tootemeeskondade sisemise Confluence'i keskkonna ning prototüüpisin tollimaksukalkulaatori mobiilivaate — mis jõudis tootmisse. Vähendasin arenduskoormust, lisades Figmas komponentide tasandi animatsioonid ja interaktiivsed olekud, mis asendas vananenud tava luua iga mikrointeraktsiooni jaoks uus kaader.\n\nOle Valmis kriisirakenduse puhul ütles kasutaja testimisel: „Miks mul on prügikott vaja? Ma ei sorteeri prügi, kui sõda on." See hetk muutis kogu toote suuna. Probleem polnud nimekirjas — puudus kontekst. Kujundasin funktsiooni ümber nii, et see selgitab iga eseme kahekordset kasutust (prügikott toimib hädaolukorras vihmamantli või magamiskoti barjäärina), ning kliendi arendusspetsialist võttis ühendust edasise koostöö arutamiseks.\n\nBotikus juhin kogu sisustrateegiat: lõin andmepõhise sotsiaalmeedia süsteemi, mis kasvas päringute mahtu 27,3%, hoidis +98,7% sissetulevat liiklust ning parandas meie Google'i keskmist positsiooni 9,5-lt 6,2-le — 29,8% orgaanilise liikluse kasv. Käivitasin kvartaliaruanded omanikule, lõin inventuuri tagasiside ahela baariga ning kujundasin enne hooaega ümber teeninduse töövoo.\n\nOtsin praegu teadlikult klienditugi- ja kliendiedukuse rolle tootepõhistes ettevõtetes. Kiireim viis saada tõhusaks sise-UX- või teenusedisaineriks on veeta aega seal, kus kasutajate valu kõige vahetumalt ilmneb. Ma ei oota juunior-disaineri ametinimetust — tahan toote intuitsiooni seestpoolt välja teenida.\n\nKui ehitad tootemeeskonda, mis väärtustab disainereid, kes on kasutajatega kümme aastat otse suhelnud — võtame ühendust.`,
    },
  };

  // ── All DOM-dependent logic runs on astro:page-load (fires on initial load
  //    AND after every View Transition swap, ensuring ClientRouter compatibility)
  document.addEventListener('astro:page-load', () => {

  // ── Language toggle logic ──────────────────────────────────────────────────
  (function () {
    let lang = localStorage.getItem('lang') || 'en';
    const toggle = document.getElementById('lang-toggle');
    const langLabel = document.getElementById('lang-label');

    function applyLang(l: string) {
      const t = (translations as Record<string, Record<string, string>>)[l];
      if (!t) return;

      document.documentElement.lang = l;

      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = (el as HTMLElement).getAttribute('data-i18n');
        if (key && t[key] !== undefined) el.textContent = t[key];
      });

      const bioEl = document.querySelector('[data-i18n-bio]');
      if (bioEl && t.bio) {
        bioEl.innerHTML = t.bio
          .split('\n\n')
          .map((p: string) => `<p>${p.replace(/\n/g, '<br>')}</p>`)
          .join('');
      }

      if (langLabel) langLabel.textContent = l === 'en' ? 'ET' : 'EN';

      // Update project titles in the showcase grid and archive list
      document.querySelectorAll('[data-project-title-en]').forEach((el) => {
        const htmlEl = el as HTMLElement;
        const newTitle = l === 'et'
          ? (htmlEl.dataset.projectTitleEt || htmlEl.dataset.projectTitleEn || '')
          : (htmlEl.dataset.projectTitleEn || '');
        htmlEl.textContent = newTitle;
      });

      localStorage.setItem('lang', l);
      lang = l;
    }

    applyLang(lang);

    if (toggle) {
      toggle.addEventListener('click', () => {
        applyLang(lang === 'en' ? 'et' : 'en');
      });
    }
  })();

  // ── Project filter bar + Load More / Show Less ───────────────────────────
  (function () {
    const pills    = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const rows     = document.querySelectorAll<HTMLElement>('.project-index-row');
    const toggleEl = document.getElementById('work-index-toggle');
    const btn      = document.getElementById('work-toggle-btn') as HTMLButtonElement | null;
    const label    = document.getElementById('work-toggle-label');
    const icon     = document.getElementById('work-toggle-icon');

    const INITIAL_VISIBLE = 3;
    let activeFilter = 'all';
    let expanded     = false;

    // ── Core render function ──────────────────────────────────────────────
    function render() {
      rows.forEach(row => {
        const idx     = parseInt(row.dataset.index ?? '0', 10);
        const rawTags = row.dataset.filterTags ?? '';
        const tags    = rawTags === '' ? [] : rawTags.split(',').map(t => t.trim());
        const matches = activeFilter === 'all' || tags.includes(activeFilter);
        const visible = matches && (activeFilter !== 'all' || idx < INITIAL_VISIBLE || expanded);

        row.style.display = visible ? 'grid' : 'none';
        row.setAttribute('aria-hidden', visible ? 'false' : 'true');
      });

      if (toggleEl) {
        toggleEl.style.display = (activeFilter === 'all' && rows.length > INITIAL_VISIBLE) ? '' : 'none';
      }

      if (btn)   btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      if (label) label.textContent = expanded ? 'Show Less' : 'Load More';
      if (icon)  icon.textContent  = expanded ? '↑' : '↓';
    }

    // ── Filter pills ──────────────────────────────────────────────────────
    pills.forEach(pill => {
      function activate() {
        activeFilter = pill.dataset.filter ?? 'all';
        // When switching to a specific filter, reset expanded so returning
        // to 'all' starts collapsed again
        if (activeFilter !== 'all') expanded = false;

        pills.forEach(p => {
          const isActive = p.dataset.filter === activeFilter;
          p.classList.toggle('filter-pill--active', isActive);
          p.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        render();
      }

      pill.addEventListener('click', activate);
      pill.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
      });
    });

    // ── Load More / Show Less button ──────────────────────────────────────
    if (btn) {
      btn.addEventListener('click', () => {
        expanded = !expanded;
        render();
        if (!expanded) {
          const section = document.getElementById('section-work');
          if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }

    // ── Initial render ────────────────────────────────────────────────────
    render();
  })();

  // ── Pill nav: smooth scroll + active state ──────────────────────────────────
  (function () {
    const navItems = document.querySelectorAll('.pill-nav-item');

    navItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = (item as HTMLAnchorElement).getAttribute('href')?.slice(1);
        if (!targetId) return;
        const target =
          document.getElementById(targetId) ||
          document.querySelector(`[data-nav-id="${targetId}"]`);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    const sections = [
      { id: 'hero-section',    navId: 'section-hey' },
      { id: 'section-about',   navId: 'section-about' },
      { id: 'section-work',    navId: 'section-work' },
      { id: 'section-contact', navId: 'section-contact' },
    ];

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const match = sections.find((s) => s.id === entry.target.id);
          if (!match) return;
          navItems.forEach((item) => {
            item.classList.toggle(
              'is-active',
              item.getAttribute('data-section') === match.navId
            );
          });
        });
      },
      { threshold: 0.35 }
    );

    sections.forEach(({ id }) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  })();

  }); // end astro:page-load
</script>
