---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;

const allProjects = await getCollection("projects");
const otherProjects = allProjects
  .filter((p) => p.id !== project.id)
  .sort((a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99))
  .slice(0, 3);

const aboutEntries = await getCollection("about");
const about = aboutEntries[0];

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
---

<Layout title={`${data.title} — ${about.data.name}`}>
  <!-- Skip to main content -->
  <a href="#main-content" class="skip-to-main">Skip to main content</a>

  <!-- Back Link Header -->
  <a href="/" class="back-link">← Back</a>

  <main id="main-content" class="project-detail">
    <!-- Project Hero -->
    <section class="project-detail-hero">
      <div class="project-detail-tags">
        {data.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>

      <h1 class="project-detail-title">{data.title}</h1>
    </section>

    <!-- Project Meta -->
    <div class="project-detail-meta">
      <div class="project-meta-item">
        <span class="project-meta-label">/ Role</span>
        <span class="project-meta-value">{data.role}</span>
      </div>

      <div class="project-meta-item">
        <span class="project-meta-label">/ Timeline</span>
        <span class="project-meta-value">
          {formatDate(data.timeline.startDate)}{data.timeline.endDate ? ` – ${formatDate(data.timeline.endDate)}` : " – Present"}
        </span>
      </div>

      <div class="project-meta-item">
        <span class="project-meta-label">/ Tools</span>
        <span class="project-meta-value">{data.tools.join(", ")}</span>
      </div>

      {data.links && data.links.length > 0 && (
        <div class="project-meta-item">
          <span class="project-meta-label">/ Links</span>
          <div>
            {data.links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="project-meta-value"
                style="display: block; text-decoration: underline; text-underline-offset: 3px;"
              >
                {link.label} ↗
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- About the Project -->
    <section class="project-detail-content">
      <h2>/ About the Project</h2>
      <p>{data.description}</p>

      <h2>/ Problem</h2>
      <p>{data.problem}</p>

      <h2>/ Solution</h2>
      <p>{data.solution}</p>

      <h2>/ Outcome</h2>
      <p>{data.outcome}</p>
    </section>

    <!-- Project Content (Markdown) -->
    <section class="project-detail-content" style="border-top: 1px solid var(--color-border); padding-top: var(--space-3xl);">
      <Content />
    </section>

    <!-- Other Projects -->
    {otherProjects.length > 0 && (
      <section style="padding: var(--space-3xl) 0;">
        <div class="section-header">
          <h2>Other</h2>
          <h2>Projects</h2>
        </div>

        {otherProjects.map((p, index) => (
          <a href={`/projects/${p.id}`} class="project-row">
            <div class="project-row-inner">
              <div class="project-row-left">
                <span class="project-number">{index + 1} /</span>
                <span class="project-title">{p.data.title}</span>
              </div>
              <div class="project-row-right">
                <span class="project-view">View Project</span>
              </div>
            </div>
          </a>
        ))}
      </section>
    )}

    <!-- Contact Section -->
    <section class="contact-section">
      <h2 class="contact-title">Get in Touch</h2>

      <div class="contact-grid">
        {about.data.contact.phone && (
          <a href={`tel:${about.data.contact.phone}`} class="contact-item">
            <span class="contact-item-value">
              {about.data.contact.phone.split('').join(' ')}
            </span>
            <span class="contact-item-label">Call</span>
          </a>
        )}

        <a href={`mailto:${about.data.contact.email}`} class="contact-item">
          <span class="contact-item-value">
            {about.data.contact.email.split('').join(' ')}
          </span>
          <span class="contact-item-label">Mail</span>
        </a>

        {about.data.socials.map((social) => (
          <a href={social.url} target="_blank" rel="noopener noreferrer" class="contact-item">
            <span class="contact-item-value">
              {social.platform.toUpperCase().split('').join(' ')}
            </span>
            <span class="contact-item-label">Follow</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-socials">
        {about.data.socials.map((social) => (
          <a href={social.url} target="_blank" rel="noopener noreferrer">
            {social.platform.substring(0, 2).toUpperCase()}
          </a>
        ))}
      </div>
      <span class="footer-credit">
        © {new Date().getFullYear()} {about.data.name}
      </span>
    </footer>
  </main>
</Layout>
